{
	"name": "httpcodes-dev",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && vp check && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"format": "vp check --fix",
		"lint": "vp check",
		"test:unit": "vp test",
		"test:client": "vp test --project=client",
		"test:server": "vp test --project=server",
		"test:ssr": "vp test --project=ssr",
		"test:ci": "vp test --run",
		"test": "pnpm run test:ci && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"coverage": "vp test --run --coverage",
		"og": "node scripts/generate-og.ts"
	},
	"devDependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "5.0.3",
		"@vitest/coverage-v8": "5.0.3",
		"playwright": "1.63.0",
		"svead": "^0.0.16",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
		"vite-plus": "1.1.0",
		"vitest": "5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	},
	"engines": {
		"node": ">=24.15.0",
		"pnpm": ">=12.0.0"
	},
	"packageManager": "pnpm@12.10.1"
}
